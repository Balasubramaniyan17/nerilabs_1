# ==============================================================================
# NeriLabs SaaS — Production AWS Environment Configuration
# ==============================================================================

# Server & Domain Settings
PORT=8000
HOST=0.0.0.0
WORKERS=4
# Public HTTPS URL where this application is accessible by clients & Stripe webhooks
APP_BASE_URL=https://app.yourdomain.com
MARKETING_URL=https://yourdomain.com

# Cryptography & Security
# Generate using: openssl rand -hex 32
JWT_SECRET=replace-with-a-secure-random-64-char-hex-key-for-production-signing
TOKEN_EXPIRATION_SECONDS=3600

# Live Stripe Billing & Connect
STRIPE_API_KEY=sk_live_51...
STRIPE_WEBHOOK_SECRET=whsec_...

# AI Variant Generation (OpenAI / Anthropic)
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-...
DEFAULT_LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.7

# Persistent Database Storage (Volume mounted path)
DATABASE_PATH=/data/nerilabs_saas_platform.db

# Multi-Armed Bandit Tuning
MAB_DEFAULT_EXPLORATION_FLOOR=0.10
MAB_MIN_SAMPLE_THRESHOLD=30
MAB_TEMPORAL_DECAY_FACTOR=0.999

# Client SDK & Telemetry Timing
CLIENT_TIMEOUT_MS=150
BEACON_BATCH_INTERVAL_MS=2000
