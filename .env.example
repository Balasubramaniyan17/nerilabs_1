# ==============================================================================
# NeriLabs SaaS Production Environment Variables
# ==============================================================================

# Server & Networking
PORT=8000
HOST=0.0.0.0
APP_BASE_URL=https://app.yourdomain.com
MARKETING_URL=https://yourdomain.com

# Cryptography & Security
JWT_SECRET=production-super-secret-hmac-sha256-key-change-in-prod-32bytes
TOKEN_EXPIRATION_SECONDS=3600

# Stripe Monetization & Stripe Connect Secrets
STRIPE_API_KEY=sk_live_51...
STRIPE_WEBHOOK_SECRET=whsec_...

# Database Storage (Persistent SQLite WAL mode on mounted volume)
DATABASE_PATH=/data/nerilabs_saas_platform.db

# Multi-Armed Bandit Tuning
MAB_DEFAULT_EXPLORATION_FLOOR=0.10
MAB_MIN_SAMPLE_THRESHOLD=30
MAB_DECAY_HALF_LIFE_HOURS=168.0

# Client SDK & Anti-Flicker Timing
CLIENT_TIMEOUT_MS=150
BEACON_BATCH_INTERVAL_MS=2000
